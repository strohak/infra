# llm-stack/.env — generated by playbook.yml on {{ ansible_date_time.date }}.
# Contains secrets: gitignored, do not commit. The playbook never overwrites
# this file; delete it (and the docker volumes, see README) to regenerate.

LANGFUSE_IMAGE_TAG={{ langfuse_image_tag }}
TELEMETRY_ENABLED=false

# ── Infrastructure secrets ───────────────────────────────────────────────────
POSTGRES_PASSWORD={{ lookup('pipe', 'openssl rand -hex 24') }}
CLICKHOUSE_PASSWORD={{ lookup('pipe', 'openssl rand -hex 24') }}
REDIS_AUTH={{ lookup('pipe', 'openssl rand -hex 24') }}
MINIO_ROOT_PASSWORD={{ lookup('pipe', 'openssl rand -hex 24') }}

# ── Langfuse app secrets ─────────────────────────────────────────────────────
NEXTAUTH_SECRET={{ lookup('pipe', 'openssl rand -hex 32') }}
SALT={{ lookup('pipe', 'openssl rand -hex 32') }}
# Must be exactly 64 hex chars (256-bit).
ENCRYPTION_KEY={{ lookup('pipe', 'openssl rand -hex 32') }}

# ── Headless init (applied on first start only) ──────────────────────────────
LANGFUSE_INIT_ORG_ID=local
LANGFUSE_INIT_ORG_NAME=Local
LANGFUSE_INIT_PROJECT_ID={{ langfuse_project_id }}
LANGFUSE_INIT_PROJECT_NAME={{ langfuse_project_id }}
# The harness authenticates with these (HTTP Basic: public:secret).
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-{{ lookup('pipe', 'openssl rand -hex 16') }}
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-{{ lookup('pipe', 'openssl rand -hex 16') }}
LANGFUSE_INIT_USER_EMAIL={{ langfuse_admin_email }}
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD={{ lookup('pipe', 'openssl rand -hex 12') }}
