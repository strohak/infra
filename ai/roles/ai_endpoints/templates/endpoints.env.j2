# {{ ansible_managed }}
# Local AI stack endpoints, written by infra/ai (roles/ai_endpoints).
# Consumers: `source` this, or read it as KEY=VALUE lines. Use only the
# OpenAI-compatible API at AI_INFERENCE_BASE_URL so the backend can change.

AI_INFERENCE_BACKEND={{ inference_backend }}
AI_INFERENCE_BASE_URL={{ inference_base_url }}
AI_INFERENCE_HEALTH_URL={{ inference_health_url }}
AI_MODEL_TIER={{ inference_tier_name }}
# Stable aliases: use these in requests. They don't change when models do.
AI_MODEL_CHAT={{ inference_aliases.chat }}
AI_MODEL_FAST={{ inference_aliases.fast }}
AI_MODEL_EMBED={{ inference_aliases.embed }}
# What each alias currently points at. Name vector collections after
# AI_MODEL_EMBED_SOURCE + AI_EMBED_DIMS: a new embedding model needs a new index.
AI_MODEL_CHAT_SOURCE={{ inference_models.chat }}
AI_MODEL_FAST_SOURCE={{ inference_models.fast }}
AI_MODEL_EMBED_SOURCE={{ inference_models.embed }}
AI_EMBED_DIMS={{ inference_embed_dims }}

QDRANT_URL={{ qdrant_url }}
QDRANT_GRPC={{ qdrant_grpc }}
QDRANT_API_KEY_FILE={{ (ai_endpoints_dir + '/qdrant-api-key') if (qdrant_api_key | default('') | length > 0) else '' }}

OPEN_WEBUI_URL={{ open_webui_url | default('') }}
