# {{ ansible_managed }}
# Secrets for Open WebUI (mode 0600). Read by Podman via EnvironmentFile=.
WEBUI_SECRET_KEY={{ open_webui_secret.content | b64decode | trim }}
{% if qdrant_api_key | default('') | length > 0 %}
QDRANT_API_KEY={{ qdrant_api_key }}
{% endif %}
TOOL_SERVER_CONNECTIONS={{ open_webui_tool_connections | to_json }}
